+        for (int attempt = 0; attempt < 2; ++attempt)
+        {
+            WindowManager.pumpEvents();
+            int w = Math.max(1, WindowManager.getWindowWidth());
+            int h = Math.max(1, WindowManager.getWindowHeight());
