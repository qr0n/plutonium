+        // Velocity estimate from the previous target — measured between server updates,
+        // so any extrapolation we applied to posX/Y/Z meanwhile can't pollute it
+        long now = System.currentTimeMillis();
+        long dt = now - this.lastServerUpdateMs;
+
+        if (this.lastServerUpdateMs != 0L && dt > 0L && dt <= 1000L)
