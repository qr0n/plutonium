+            double ticks = (double)dt / 50.0D;
+            double vx = (x - this.otherPlayerMPX) / ticks;
+            double vy = (y - this.otherPlayerMPY) / ticks;
+            double vz = (z - this.otherPlayerMPZ) / ticks;
+
+            if (vx * vx + vy * vy + vz * vz > 1.0D)
+            {
+                // over 1 block/tick is a teleport, not motion — don't extrapolate it
+                this.extrapVelX = this.extrapVelY = this.extrapVelZ = 0.0D;
+            }
+            else
+            {
+                this.extrapVelX = this.extrapVelX * 0.5D + vx * 0.5D;
+                this.extrapVelY = this.extrapVelY * 0.5D + vy * 0.5D;
+                this.extrapVelZ = this.extrapVelZ * 0.5D + vz * 0.5D;
+            }
+        }
+        else
+        {
+            this.extrapVelX = this.extrapVelY = this.extrapVelZ = 0.0D;
