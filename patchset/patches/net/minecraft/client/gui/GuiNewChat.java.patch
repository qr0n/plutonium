+    /** Returns the full chat line text at the given mouse position, or null if none. */
+    public String getFullLineTextAt(int mouseX, int mouseY)
+    {
+        if (!this.getChatOpen()) return null;
+        ScaledResolution scaledresolution = new ScaledResolution(this.mc);
+        int scaleFactor = scaledresolution.getScaleFactor();
+        float chatScale = this.getChatScale();
+        int mx = mouseX / scaleFactor - 3;
+        int my = mouseY / scaleFactor - 27;
+        mx = MathHelper.floor_float((float)mx / chatScale);
+        my = MathHelper.floor_float((float)my / chatScale);
+        if (mx < 0 || my < 0) return null;
+        int visibleLines = Math.min(this.getLineCount(), this.drawnChatLines.size());
+        if (my >= this.mc.fontRendererObj.FONT_HEIGHT * visibleLines + visibleLines) return null;
+        int lineIndex = my / this.mc.fontRendererObj.FONT_HEIGHT + this.scrollPos;
+        if (lineIndex < 0 || lineIndex >= this.drawnChatLines.size()) return null;
+        ChatLine chatLine = this.drawnChatLines.get(lineIndex);
+        if (chatLine == null) return null;
+        return net.minecraft.util.EnumChatFormatting.getTextWithoutFormattingCodes(
+            chatLine.getChatComponent().getFormattedText());
+    }
