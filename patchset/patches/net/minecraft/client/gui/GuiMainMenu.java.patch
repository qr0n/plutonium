+                String name = acc.getUsername();
+                int rowY   = listStartY + (i - accountScroll) * MODAL_ROW_H;
+                boolean isCurrent = name.equals(currentName);
+                boolean rowHover  = mouseX >= mx + 2 && mouseX < mx + MODAL_W - 20
+                        && mouseY >= rowY && mouseY < rowY + MODAL_ROW_H;
+
+                if (isCurrent)
+                    drawRect(mx + 2, rowY, mx + MODAL_W - 20, rowY + MODAL_ROW_H, 0x335D50F0);
+                else if (rowHover)
+                    drawRect(mx + 2, rowY, mx + MODAL_W - 20, rowY + MODAL_ROW_H, 0x1A5D50F0);
+
+                // Name (highlight active in purple)
+                int nameColor = isCurrent ? 0xFF7B6FFF : 0xFFEEECFF;
+                this.fontRendererObj.drawString(name, mx + 8, rowY + (MODAL_ROW_H - 8) / 2, nameColor);
+
+                // Remove X
