+        float ease = 1f - (float) Math.pow(1f - anim, 3f);
+
+        int mx = (this.width  - MODAL_W) / 2;
+        int my = (this.height - MODAL_H) / 2 + (int)((1f - ease) * 10);
+
+        // Shadow
+        DrawUtils.drawRect(mx + 3, my + 4, MODAL_W, MODAL_H, 0x55000000);
+
+        // Panel — semi-transparent so panorama bleeds through
+        DrawUtils.drawRoundedRect(mx, my, MODAL_W, MODAL_H, 0xCC080B16);
+        DrawUtils.drawRoundedRectBorder(mx, my, MODAL_W, MODAL_H, 0x886C63FF);
+
+        // Header gradient + gloss
