+    private void handleModalClick(int mouseX, int mouseY, int mouseButton) throws IOException
+    {
+        if (mouseButton != 0) return;
+
+        int mx = (this.width  - MODAL_W) / 2;
+        int my = (this.height - MODAL_H) / 2;
+
+        // Click outside modal → close
+        if (mouseX < mx || mouseX > mx + MODAL_W || mouseY < my || mouseY > my + MODAL_H)
+        {
+            accountModalOpen = false;
+            return;
+        }
+
+        // Close X
+        int closeX = mx + MODAL_W - 12;
+        int closeY = my + (MODAL_HEADER_H - 8) / 2;
+        if (mouseX >= closeX && mouseX < closeX + 8 && mouseY >= closeY && mouseY < closeY + 8)
+        {
+            accountModalOpen = false;
+            return;
+        }
+
+        // Account rows
+        java.util.List<Account> accs = AccountManager.getAccounts();
+        int listStartY = my + MODAL_HEADER_H + 2;
+        for (int i = accountScroll; i < accountScroll + MODAL_MAX_ROWS && i < accs.size(); i++)
+        {
+            String name = accs.get(i).getUsername();
+            int rowY = listStartY + (i - accountScroll) * MODAL_ROW_H;
+
+            // Remove X
+            int xBtnX = mx + MODAL_W - 18;
+            if (mouseX >= xBtnX && mouseX < xBtnX + 12 && mouseY >= rowY && mouseY < rowY + MODAL_ROW_H)
+            {
+                AccountManager.remove(name);
+                accountScroll = Math.max(0, Math.min(accountScroll,
+                        AccountManager.getAccounts().size() - MODAL_MAX_ROWS));
+                return;
+            }
+
+            // Row click → switch
+            if (mouseX >= mx + 2 && mouseX < mx + MODAL_W - 20
+                    && mouseY >= rowY && mouseY < rowY + MODAL_ROW_H)
+            {
+                AccountManager.switchTo(name);
+                return;
+            }
+        }
+
+        // Add button
+        int sepY    = my + MODAL_HEADER_H + 2 + MODAL_MAX_ROWS * MODAL_ROW_H;
+        int addBtnX = mx + MODAL_W - 48;
+        int addBtnY = sepY + 3;
+        int addBtnW = 44;
+        int addBtnH = 20;
+        if (mouseX >= addBtnX && mouseX < addBtnX + addBtnW
+                && mouseY >= addBtnY && mouseY < addBtnY + addBtnH)
+        {
+            if (accountAddField != null)
+            {
+                String name = accountAddField.getText().trim();
+                if (!name.isEmpty())
+                {
+                    AccountManager.add(name);
+                    accountAddField.setText("");
+                }
+            }
+            return;
+        }
+
+        // Forward to add-field
+        if (accountAddField != null)
+            accountAddField.mouseClicked(mouseX, mouseY, mouseButton);
+    }
