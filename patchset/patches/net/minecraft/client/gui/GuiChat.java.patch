+    /**
+     * Handles /pf (plutonium filter) commands locally without sending to the server.
+     * Returns true if the input was consumed as a filter command.
+     */
+    private boolean handleFilterCommand(String input)
+    {
+        if (!input.startsWith("/pf")) return false;
+
+        String rest = input.substring(3).trim(); // everything after "/pf"
+        net.minecraft.client.gui.GuiNewChat chat = this.mc.ingameGUI.getChatGUI();
+
+        if (rest.isEmpty() || rest.equals("help"))
+        {
+            chat.printChatMessageUnfiltered(new ChatComponentText("§e[ChatFilter] §7Commands:"));
+            chat.printChatMessageUnfiltered(new ChatComponentText("§7  /pf add <text>    §f- add a filter"));
+            chat.printChatMessageUnfiltered(new ChatComponentText("§7  /pf remove <n>    §f- remove filter by index"));
+            chat.printChatMessageUnfiltered(new ChatComponentText("§7  /pf list          §f- list all filters"));
+            chat.printChatMessageUnfiltered(new ChatComponentText("§7  /pf clear         §f- remove all filters"));
+            return true;
+        }
+
+        if (rest.startsWith("add "))
+        {
+            String phrase = rest.substring(4).trim();
+            if (phrase.isEmpty())
+            {
+                chat.printChatMessageUnfiltered(new ChatComponentText("§c[ChatFilter] Usage: /pf add <text>"));
+            }
+            else if (plutonium.module.modules.ChatFilter.addFilter(phrase))
+            {
+                chat.printChatMessageUnfiltered(new ChatComponentText(
+                    "§e[ChatFilter] §aAdded filter: §f" + phrase));
+            }
+            else
+            {
+                chat.printChatMessageUnfiltered(new ChatComponentText(
+                    "§e[ChatFilter] §cFilter already exists: §f" + phrase));
+            }
+            return true;
+        }
+
+        if (rest.startsWith("remove "))
+        {
+            String arg = rest.substring(7).trim();
+            try
+            {
+                int idx = Integer.parseInt(arg) - 1; // 1-based input
+                if (plutonium.module.modules.ChatFilter.removeFilter(idx))
+                    chat.printChatMessageUnfiltered(new ChatComponentText("§e[ChatFilter] §aRemoved filter #" + (idx + 1)));
+                else
+                    chat.printChatMessageUnfiltered(new ChatComponentText("§c[ChatFilter] Invalid index: " + (idx + 1)));
+            }
+            catch (NumberFormatException e)
+            {
+                chat.printChatMessageUnfiltered(new ChatComponentText("§c[ChatFilter] Usage: /pf remove <number>"));
+            }
+            return true;
+        }
+
+        if (rest.equals("list"))
+        {
+            java.util.List<String> filters = plutonium.module.modules.ChatFilter.getFilters();
+            if (filters.isEmpty())
+            {
+                chat.printChatMessageUnfiltered(new ChatComponentText("§e[ChatFilter] §7No active filters."));
+            }
+            else
+            {
+                chat.printChatMessageUnfiltered(new ChatComponentText("§e[ChatFilter] §7Active filters (" + filters.size() + "):"));
+                for (int i = 0; i < filters.size(); i++)
+                {
+                    chat.printChatMessageUnfiltered(new ChatComponentText("§7  " + (i + 1) + ". §f" + filters.get(i)));
+                }
+            }
+            return true;
+        }
+
+        if (rest.equals("clear"))
+        {
+            plutonium.module.modules.ChatFilter.clearFilters();
+            chat.printChatMessageUnfiltered(new ChatComponentText("§e[ChatFilter] §aAll filters cleared."));
+            return true;
+        }
+
+        chat.printChatMessageUnfiltered(new ChatComponentText("§c[ChatFilter] Unknown command. Type /pf help for usage."));
+        return true;
+    }
