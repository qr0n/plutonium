+    /**
+     * Emit and draw this box's geometry immediately at the current modelview.
+     * Replaces the removed display-list playback (GlStateManager.callList).
+     */
+    private void renderCubes(float scale)
+    {
+        // All cubes of this ModelRenderer share one transform/texture/format, so batch
+        // them into a single begin/draw instead of one draw call per quad (6x fewer
+        // draws per box, ~tens fewer per model — big win for crowded entity scenes).
+        if (this.cubeList.isEmpty())
