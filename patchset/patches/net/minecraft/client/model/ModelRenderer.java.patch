+        // Fast path: accumulate this part into the cross-part model batch (one draw per
+        // model/texture instead of one per part).
+        if (plutonium.gpu.ModelBatch.ENABLED)
+        {
+            for (int i = 0; i < this.cubeList.size(); ++i)
+            {
+                plutonium.gpu.ModelBatch.emitBox((ModelBox)this.cubeList.get(i), scale);
+            }
+        }
+        else
