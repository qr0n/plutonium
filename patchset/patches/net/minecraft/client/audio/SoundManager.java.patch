+    /**
+     * paulscode's LibraryJavaSound auto-ranks mixers and on modern JDKs (notably
+     * macOS/Temurin 21) picks a "Port" mixer — the mic/speaker volume-control
+     * device, which cannot play audio. Every sound then fails with "Unable to
+     * create clip". If the engine's current mixer can't open a real playback
+     * line, force it onto one that supports both Clip and SourceDataLine. The
+     * library's own rank test logs a spurious "unuseable" error here, but actual
+     * playback through the forced mixer works.
+     */
+    static void fixJavaSoundMixer()
+    {
+        try
+        {
+            AudioFormat fmt = new AudioFormat(44100.0F, 16, 2, true, false);
+            DataLine.Info sdlInfo = new DataLine.Info(SourceDataLine.class, fmt);
+
+            Mixer current = LibraryJavaSound.getMixer();
+            if (current != null && current.isLineSupported(sdlInfo))
+            {
+                return; // already on a playback-capable mixer
+            }
+
+            DataLine.Info clipInfo = new DataLine.Info(Clip.class, fmt);
+            Mixer chosen = null;
+            for (Mixer.Info mi : AudioSystem.getMixerInfo())
+            {
+                Mixer m = AudioSystem.getMixer(mi);
+                if (m.isLineSupported(sdlInfo) && m.isLineSupported(clipInfo))
+                {
+                    chosen = m;
+                    // Prefer the system default device when available.
+                    if (mi.getName() != null && mi.getName().contains("Default"))
+                    {
+                        break;
+                    }
+                }
+            }
+
+            if (chosen != null)
+            {
+                LibraryJavaSound.setMixer(chosen);
+                logger.info(LOG_MARKER, "Forced JavaSound output mixer: " + chosen.getMixerInfo().getName());
+            }
+            else
+            {
+                logger.warn(LOG_MARKER, "No playback-capable JavaSound mixer found; audio may be silent");
+            }
+        }
+        catch (Throwable t)
+        {
+            // setMixer logs a benign "unuseable" rank error; ignore failures here.
+            logger.warn(LOG_MARKER, "Could not override JavaSound mixer", t);
+        }
+    }
